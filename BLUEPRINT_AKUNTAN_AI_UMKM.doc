    </tr>
    <tr>
      <td>Pelunasan Piutang</td>
      <td>1001 Kas / 1002 Bank</td>
      <td>1004 Piutang Usaha</td>
      <td>Uang diterima dari pelanggan</td>
    </tr>
    <tr>
      <td>Beli Stok Kredit (Supplier)</td>
      <td>1003 Persediaan Barang</td>
      <td>2001 Hutang Usaha</td>
      <td>Tagihan pembelian masuk</td>
    </tr>
    <tr>
      <td>Pelunasan Hutang Supplier</td>
      <td>2001 Hutang Usaha</td>
      <td>1001 Kas / 1002 Bank</td>
      <td>Pembayaran dikirim ke vendor</td>
    </tr>
    <tr>
      <td>Beban Operasional (Listrik/Gaji)</td>
      <td>6001 - 6006 Beban Ops</td>
      <td>1001 Kas &amp; Setara Kas</td>
